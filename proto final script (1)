import time
import traceback
from collections import Counter

import cv2
import numpy as np

from cjm_byte_track.core import BYTETracker

# Picamera2 for Raspberry Pi 5
from picamera2 import Picamera2, Preview

# -------------------------
# CONFIG
# -------------------------
NAMES = [
    'Bicycle', 'Fire-extinguisher', 'ball-basketball', 'ball-football',
    'ball-volleyball', 'barrel', 'can', 'cardboard', 'cone-queuemanager cone',
    'cone-sportscone', 'cone-trafficcone', 'drum', 'gunnybag', 'jerrycan',
    'lifeguard tube', 'mannequin', 'motorbike', 'scooter', 'watercans'
]

CONF_THRESH = 0.25
IOU_THRESH = 0.45

# Point this to your TFLite model (update filename if needed)
MODEL_PATH = r"/home/pi/models/best_8_float16.tflite"  # change as needed

# Display and model input size (square)
DISPLAY_SIZE = 640          # screen and model input are 640x640
MODEL_INPUT_SIZE = 640

# Zoom (digital). Start at 1.0 (no zoom). Adjust with '+' and '-' keys.
ZOOM_FACTOR = 1.0
ZOOM_STEP = 0.1
ZOOM_MIN = 1.0
ZOOM_MAX = 4.0

# Counting line fraction (70% down)
LINE_FRACTION = 0.7

# Visual style
INFO_BG_ALPHA = 0.65
INFO_BG_COLOR = (20, 20, 20)
INFO_TEXT_COLOR = (220, 220, 220)
BOX_COLOR = (0, 200, 0)
LINE_COLOR = (0, 0, 220)
LINE_THICKNESS = 2
BOX_THICKNESS = 2
LABEL_FONT_SCALE = 0.5
LABEL_FONT_THICK = 1

WINDOW_TITLE = "YOLOv8 TFLite — 640x640 (PiCam2)"

# -------------------------
# Safe Interpreter import (internal -> fallback)
# -------------------------
print("Starting — loading TFLite Interpreter...")

try:
    from tensorflow.lite.python.interpreter import Interpreter as _TFInterpreterInternal
    Interpreter = _TFInterpreterInternal
    print("Using internal TensorFlow Lite Interpreter")
except ImportError:
    try:
